#!/bin/sh
# This distribution installs only into the current user's home directory.
set -eu
relative="Library/Application Support/obs-studio/plugins"
plugins="${2:-${HOME:?}}/$relative"
[ -d "$plugins/better-clips.plugin" ] || plugins="${HOME:?}/$relative"
[ -d "$plugins/better-clips.plugin" ] || exit 1
rm -rf "$plugins/obs-replay-r2.plugin"
