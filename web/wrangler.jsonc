{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clips",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/api/*", "/s/*"]
  },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "clips" }],
  // Slows down password guessing: 10 sign-in tries per minute per IP.
  "ratelimits": [
    {
      "name": "LOGIN_LIMIT",
      "namespace_id": "4271",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  // Daily cleanup of old clips (worker/index.ts).
  "triggers": { "crons": ["30 4 * * *"] },
  "observability": { "enabled": true }
}
