{
  "name": "clips",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@12.0.0",
  "scripts": {
    "dev": "vite",
    "build": "wrangler types && tsc -b && vite build",
    "lint": "eslint . && oxlint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "doctor": "react-doctor --blocking warning",
    "check": "wrangler types && tsc -b && eslint . && oxlint && react-doctor --blocking warning"
  },
  "cloudflare": {
    "bindings": {
      "APP_PASSWORD": {
        "description": "The password you sign in to your clips app with. Use **12 or more characters**, for example from `openssl rand -base64 18`."
      },
      "BUCKET": {
        "description": "The R2 bucket your clips are stored in. OBS uploads to it through this app, so you need no R2 API keys."
      }
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "^5.108.3",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "hono": "^4.13.20",
    "jose": "^6.2.18",
    "mediabunny": "^1.66.2",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/workers-types": "^5.20261123.1",
    "@eslint/js": "^10",
    "@oxlint/plugins": "1.78.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "oxlint": "1.78.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-doctor": "^0.9.23",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8",
    "wrangler": "^4.166.0"
  }
}
