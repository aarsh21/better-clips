// Hosted YouTube app. Secrets: CREDS_KEY, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clips-app",
  "account_id": "1a9cd8ace49e0b10ee2c93d46c40a3fa",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clips-app",
      "database_id": "9a11e3cd-dcc0-4283-a1da-7b704a8932ed",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true },
}
