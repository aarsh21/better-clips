#!/usr/bin/env bash
# Run one chapter against the local stack. No HTTP mutation substitutes for a UI action.
set -euo pipefail
phase=${1:-help}; id=${2:-}; S=$(dirname "$(realpath "$0")")
if [[ ! $id =~ ^[a-z0-9]{1,8}$ ]]; then echo 'drive {install|length|channel|player|edit|direct|credentials} RUN_ID'; exit 2; fi
cd "$(git rev-parse --show-toplevel)"; export DISPLAY=:97 R=/dev/shm/better-clips-$UID-$id E=$PWD/.amp/in/artifacts/bc-$id
[[ -f $R/owner && $(cat "$R/owner") == "$PWD" ]] || { echo 'Start this run with lab start first'; exit 1; }
unset HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy
C=$R/config/obs-studio; cfg=$C/plugin_config/better-clips/config.json
db=$(find "$R/state/v3/d1" -name '*.sqlite' ! -name metadata.sqlite)
session=yt-$id; b(){ agent-browser --session "$session" "$@"; }; button(){ b find role button click --name "$1"; }
o(){ "$S/obs-ui" "$@"; }; osnap(){ import -window root -resize 1100 "$E/$1.jpg"; }; bsnap(){ b screenshot "$E/$1.png"; }
settings(){ o Settings --role button --last; }; dest(){ o "$1" --role 'combo box'; xdotool key "$2" Return; }
field(){ o "$1"; xdotool key ctrl+a; xdotool type --clearmodifiers "$2"; }; hotkey(){ xdotool keydown Control_L keydown Alt_L keydown r sleep .25 keyup r keyup Alt_L keyup Control_L; }
waitfor(){ for i in {1..100}; do "$@" >/dev/null 2>&1 && return; sleep .4; done; echo "Timed out waiting for $1" >&2; return 1; }
sql(){ sqlite3 -readonly "$db" "$1"; }; row(){ [[ $(sql "$1") == "$2" ]]; }; log(){ grep '\[better-clips\]' "$(ls -t "$C"/logs/*.txt | head -1)"; }
uploads(){ [[ $(log | grep -c 'Uploaded ') -ge $1 ]]; }; clip(){ xclip -sel clipboard -o 2>/dev/null; }; copied(){ [[ $(clip) == $1* && $(clip) != "${2:-}" ]]; }
pair(){ jq -e --argjson route "$1" '.youtube_channel_title=="Local channel" and .youtube_route==$route' "$cfg"; }
google_signin(){ b find role button click --name 'Sign in with Google'; b wait --text 'Before you connect YouTube'; b find role link click --name Continue; }
account(){ b open http://localhost:8787/apps/; b wait 'button[aria-label="Settings"]'; button Settings; b wait '[role=tablist]'; sleep .4; b find role tab click --name YouTube; b wait --text 'Paired OBS devices'; sleep .4; }
connect(){ o "$1"; waitfor pair "$2"; waitfor o --has 'Connected. Click Save to upload clips to this channel.'; }
clean_tokens(){ for f in "$cfg" "$cfg.bak"; do jq -e 'has("youtube_refresh_token")|not' "$f" >/dev/null && ! grep -qF testing-refresh "$f" || return 1; done; }
keyring(){ DBUS_SESSION_BUS_ADDRESS="unix:path=$R/bus" secret-tool "$@"; }
ready_copy(){
  local path
  path=$(find "$R/recordings" -name "*${1}.mp4" -type f); test -s "$path"
  ffprobe -v error -show_entries format=duration,size -of compact "$path" >>"$E/recovery.log"
  waitfor o --has 'is ready to play'; test -s "$path"; echo "Retained after ready: ${path##*/}" >>"$E/recovery.log"
}
last_uuid(){ log | sed -nE 's/.*Saved replay .*_([a-f0-9]{32})\.mp4 from memory.*/\1/p' | tail -1; }
case "$phase" in
install)
  "$S/lab" install "$id"; timeout 15 xdotool search --sync --onlyvisible --name "Auto-Configuration Wizard" >/dev/null
  waitfor o --has 'Auto-Configuration Wizard'; xdotool key Escape
  # xdotool search can hit BadWindow as the wizard disappears. Observe the modal itself.
  for i in {1..20}; do
    if o --has 'No Sources'; then waitfor o --has Yes; o Yes --role button; break; fi
    sleep .2
  done
  waitfor bash -c '[[ $(xdotool getactivewindow getwindowname) == OBS\ *Profile:* ]]'
  "$S/lab" quit "$id"; "$S/scene.py"; "$S/lab" obs "$id"; waitfor o --has "Connect YouTube"; osnap first-run ;;
length)
  # Interrupt only the plugin output, via the disposable scene's fault fixture.
  touch "$R/stop-output"; waitfor o --has 'Retry Better Clips Buffer'; o --has 'OBS buffer: running · Better Clips: off'; osnap retry-buffer
  o 'Retry Better Clips Buffer'; waitfor o --has 'OBS buffer: running · Better Clips: running'
  for profile in default one-second; do
    if [[ $profile == one-second ]]; then
      "$S/lab" quit "$id"; p=$C/basic/profiles/Untitled
      sed -i '/^\[Output\]/,/^\[/s/^Mode=.*/Mode=Advanced/; /^\[AdvOut\]/,/^\[/{s/^RecEncoder=.*/RecEncoder=obs_x264/; s/^RecRB=.*/RecRB=true/; s/^RecRBTime=.*/RecRBTime=12/;}' "$p/basic.ini"
      sed -i "s|^RecFilePath=.*|RecFilePath=$R/recordings|" "$p/basic.ini"
      printf '{"keyint_sec":1}\n' >"$p/recordEncoder.json"; "$S/lab" obs "$id"; "$S/lab" doctor "$id"
    fi
    waitfor o --has "Save Replay to YouTube"; o "" --role "spin button" --last; xdotool key ctrl+a; xdotool type 12; xdotool key Return
    sleep 24; old_link=$(clip || :); o "Save Replay to YouTube"; waitfor copied https://youtu.be/test "$old_link"
    cp "$R/recordings/$(ls -t "$R/recordings" | head -1)" "$R/window.mp4"
    log | sed -n '/In-memory replay buffer started/h; /In-memory replay buffer started/!H; ${x;p;}' >"$R/arm.log"
    warnings=$(grep -Ec 'Better Clips: clips can be up to about [0-9.]+ s longer than the setting\. Set the recording encoder.s keyframe interval to 1–2 s in Settings → Output → Recording → Keyframe Interval\.' "$R/arm.log" || :)
    python3 - "$R/window.mp4" "$profile" "$warnings" <<'PY' | tee -a "$E/keyframes.log"
import json, subprocess, sys
p, profile, warnings = sys.argv[1:]
video = json.loads(subprocess.check_output(['ffprobe','-v','error','-select_streams','v:0','-show_entries','packet=pts_time,flags:format=duration','-of','json',p]))
keys = [float(pkt['pts_time']) for pkt in video['packets'] if 'K' in pkt['flags']]
gap = max(b-a for a,b in zip(keys,keys[1:])); duration = float(video['format']['duration'])
print(f'{profile}: setting=12s duration={duration}s max keyframe gap={gap:.3f}s warnings={warnings}')
assert 'K' in video['packets'][0]['flags'] and 12 <= duration <= 12+gap
assert (0.99 <= gap <= 1.01 and warnings=='0') if profile=='one-second' else (gap>2 and warnings=='1')
PY
  done ;;
channel)
  session=yt-$id; b open about:blank; b network route 'https://**' --abort; b open http://localhost:8787/apps/; b set viewport 1100 740 2; b wait --text 'Sign in with Google'; bsnap google-before; google_signin; b wait --text 'NO CLIPS YET'
  cp "$cfg" "$R/never-paired.json"
  settings; field 'Better Clips app' http://localhost:8787; connect 'Sign in with YouTube' 0
  o 'Remove channel from app…'; waitfor o --has 'Remove channel everywhere?'; osnap remove-confirm; xdotool key Escape; row 'select count(*) from youtube_accounts' 1
  o 'Remove channel from app…'; o 'Remove channel everywhere'; waitfor row 'select count(*) from youtube_accounts' 0
  connect 'Reconnect YouTube' 0; o Save --role button; first=$(sql 'select id from youtube_devices'); test -n "$first"
  # Simulate a second machine by launching the same real OBS with a never-paired config.
  "$S/lab" quit "$id"; cp "$R/never-paired.json" "$cfg"; "$S/lab" obs "$id"; "$S/lab" doctor "$id"
  settings; field 'Better Clips app' http://localhost:8787; connect 'Sign in with YouTube' 0
  row 'select count(*) from youtube_devices' 2; o 'Unpair this OBS'; waitfor o --has 'Reconnect YouTube'; row 'select id from youtube_devices' "$first"; row 'select count(*) from youtube_accounts' 1
  connect 'Reconnect YouTube' 0; account; b wait --fn 'document.querySelectorAll("[aria-label^=\"Remove OBS\"]").length===2'; bsnap devices
  button "Remove OBS ${first:0:8}"; waitfor row 'select count(*) from youtube_devices' 1; row "select count(*) from youtube_devices where id='$first'" 0
  o --has "By clicking 'upload,'"; osnap audience-settings
  ffmpeg -loglevel error -f x11grab -draw_mouse 1 -video_size 1440x900 -framerate 12 -i :97 -t 6 -vf scale=1152:-2 -threads 2 -c:v libx264 -pix_fmt yuv420p -crf 23 -y "$E/audience-choice.mp4" & recorder=$!
  sleep .7; o No --role 'combo box'; sleep .7; o --has Yes; o --has No; xdotool key Escape; wait "$recorder"
  # Remove the *current* device while settings is closed, then save without reopening settings. Only upload can observe this 401.
  o Save --role button; current=$(sql 'select id from youtube_devices'); button "Remove OBS ${current:0:8}"; b wait --text 'No devices paired'; o 'Save Replay to YouTube'; waitfor o --has 'Connect YouTube'; o 'Connect YouTube'; o --has 'Reconnect YouTube'; osnap after-upload-401
  connect 'Reconnect YouTube' 0
  for size in 1440x900 1366x768; do
    if [[ $size == 1366x768 ]]; then xrandr --newmode "$size" 85.5 1366 1436 1579 1792 768 771 774 798; xrandr --addmode screen "$size"; xrandr --output screen --mode "$size"; sleep .6; fi
    o Save --role button --bounds; o Cancel --role button --bounds; osnap "settings-$size"; o --scroll-form
  done >"$E/settings-layout.log"
  xrandr --output screen --mode 1440x900; sleep .6; osnap paired; o Save --role button; waitfor o --has 'Save Replay to YouTube'; o 'Save Replay to YouTube'
  waitfor copied https://youtu.be/test; clip >"$E/host-link.txt"; osnap host-upload; ready_copy "$(last_uuid)"; row "select madeForKids from youtube_clips where videoId='$(basename "$(clip)")' and status='ready'" 0
  # The ready state is fetched by the plugin. Capture the dock, not just the database.
  waitfor o --has 'is ready to play'; [[ $(clip) == "$(cat "$E/host-link.txt")" ]]; osnap ready; b open http://localhost:8787/apps/; b wait --text '1 clip'; bsnap hosted-library ;;
player)
  session=yt-$id
  for state in kids unknown adult; do
    echo "$state" >"$R/google-audience"
    # Expire the cache, not the classification. Only the Worker's videos.list writes that.
    sqlite3 "$db" 'update youtube_clips set nextSync=0'; b reload; b wait --text '1 clip'
    case $state in kids) want=1;; unknown) want=NULL;; adult) want=0;; esac
    waitfor row "select count(*) from youtube_clips where madeForKids is $want and nextSync>unixepoch('subsec')*1000+60000" 1
    b reload; b wait --text '1 clip'; button 'Unlisted 0:13'
    if [[ $state == adult ]]; then b wait 'iframe[src*="youtube.com/embed/"]'
    else
      b wait --text 'Watch on YouTube'; [[ $(b eval "document.querySelectorAll('iframe,script[src*=iframe_api]').length") == 0 ]]
      [[ $(b eval "[...document.links].find(a=>a.textContent.includes('Watch on YouTube')).href" | tr -d '"') == "$(cat "$E/host-link.txt")" ]]
    fi
    bsnap "player-$state"; button Close; b wait --fn '!document.querySelector("[role=dialog]")'
  done
  rm "$R/google-audience" ;;
edit)
  session=yt-$id; bsnap edit-before; button 'Unlisted 0:13'; b press e; b find role textbox fill 'Night practice' --name 'Clip name'; b press Enter; b wait --text 'Pending: Night practice'; bsnap pending-title
  button Unlisted; b wait '[role=menuitem]'; b find role menuitem click --name 'Private Only you can watch it'; b wait --text 'Waiting for YouTube to confirm visibility'; bsnap pending-privacy
  b wait --text 'Private on YouTube' --timeout 90000; b wait --fn 'document.body.innerText.includes("Night practice") && !document.body.innerText.includes("Pending: Night practice")'; row "select count(*) from youtube_clips where title='Night practice' and privacy='private' and pendingPrivacy is null and pendingTitle is null" 1
  [[ $(b eval "[...document.querySelectorAll('button')].find(x=>x.textContent.includes('Edit — coming soon'))?.disabled") == true ]]
  [[ $(b get attr 'a[href^="https://studio.youtube.com/video/"]' href | tr -d '"') == "https://studio.youtube.com/video/$(basename "$(cat "$E/host-link.txt")")/edit" ]]
  button Close; account; button 'Disconnect YouTube'; b wait --text 'This removes 1 library entry from Better Clips. This unpairs 1 OBS device.'; bsnap disconnect-counts; button Cancel; button Close; b wait --fn '!document.querySelector("[role=dialog]")'
  button 'Night practice'; button Delete; b wait --text 'Delete this video from YouTube?'; sleep .4; button 'Delete from YouTube'; b wait --text 'Save a replay in OBS and it will show up here.'; row 'select count(*) from youtube_clips' 0
  # Verify deletion survives a reload and the closing confirmation no longer covers Settings.
  b reload; b wait --text 'Save a replay in OBS and it will show up here.'
  button Settings; b wait '[role=tablist]'; sleep .4; b find role tab click --name YouTube; b wait --text 'Disconnect YouTube'; sleep .4
  button 'Disconnect YouTube'; b wait --text 'Your videos stay on YouTube'; b wait --fn '!/library entr|cut point|0 OBS devices/.test(document.querySelector("[role=tabpanel]").innerText)'; button Disconnect; b wait --text 'Connect YouTube'; row 'select count(*) from youtube_accounts' 0; bsnap web-disconnected ;;
direct)
  cp "$cfg" "$R/stale-device.json"; jq -e '.youtube_upload_token!=""' "$cfg" >/dev/null
  settings; waitfor o --has 'Reconnect YouTube'; o --has 'Not connected'; waitfor o --has 'Connect YouTube'; osnap hosted-unpaired; o Cancel --role button
  # A machine offline for the revocation must forget the same token on startup, before opening Settings.
  "$S/lab" quit "$id"; cp "$R/stale-device.json" "$cfg"; "$S/lab" obs "$id"; "$S/lab" doctor "$id"; waitfor jq -e '.youtube_upload_token==""' "$cfg"; waitfor o --has 'Connect YouTube'; o 'Connect YouTube'
  o --has 'Reconnect YouTube'; o 'Directly to YouTube'; connect 'Sign in with YouTube' 1; osnap direct-paired
  grant=$(jq -er '.youtube_credential_id | select(length>0)' "$cfg"); [[ $(keyring lookup grant "$grant") == testing-refresh ]]; clean_tokens
  dest No y
  o 'Review each clip before uploading' --indicator; osnap review-checked; o Save --role button; waitfor o --has 'Save Replay to YouTube'; hotkey; w=$(timeout 20 xdotool search --sync --onlyvisible --name '^Upload this clip to YouTube\?' | tail -1); xdotool windowactivate --sync "$w"; osnap review; o Upload --role button
  waitfor copied https://youtu.be/test "$(cat "$E/host-link.txt")"; clip >"$E/direct-link.txt"; row 'select count(*) from youtube_clips' 0; ready_copy "$(last_uuid)"; osnap direct-uploaded
  settings; o Disconnect; waitfor jq -e '.youtube_credential_id=="" and .youtube_channel_title==""' "$cfg"; clean_tokens; [[ -z $(keyring lookup grant "$grant") ]]; osnap direct-disconnected; o Cancel --role button
  log | grep -E '(plugin loaded|In-memory replay buffer|Saved replay|Built |Uploaded |YouTube upload failed)' >"$E/plugin.log"
  sed -nE 's/.*\[better-clips\] Saved replay (.*) from memory .*/\1/p' "$C"/logs/*.txt >"$E/save-names.log"
  awk -F_ '{id=$NF; sub(/\.mp4$/,"",id); if ($0 !~ /_[a-f0-9]+\.mp4$/ || length(id)!=32 || seen[id]++) bad=1} END{exit bad || NR<2}' "$E/save-names.log" ;;
credentials)
  o 'Connect YouTube'; connect 'Reconnect YouTube' 1; o Save --role button
  # Emulate upgrading that connected channel from the plaintext release.
  last_id=$(jq -er '.youtube_credential_id | select(length>0)' "$cfg")
  "$S/lab" quit "$id"
  keyring clear grant "$last_id"
  jq '.youtube_route=1 | .youtube_refresh_token="testing-refresh" | .youtube_channel_id="UC-local-testing" | .youtube_channel_title="Local channel" | .youtube_review=false | .youtube_made_for_kids=false | del(.youtube_credential_id)' "$cfg" >"$R/legacy-direct.json"
  for storage in keyring session; do
    cp "$R/legacy-direct.json" "$cfg"; jq '.youtube_refresh_token="obsolete-testing-refresh"' "$cfg" >"$cfg.bak"
    if [[ $storage == session ]]; then touch "$R/no-keyring"; fi
    "$S/lab" obs "$id"; clean_tokens
    if [[ $storage == keyring ]]; then
      grant=$(jq -er '.youtube_credential_id | select(length>0)' "$cfg"); [[ $(keyring lookup grant "$grant") == testing-refresh ]]
      "$S/lab" quit "$id"; "$S/lab" obs "$id"; waitfor o --has 'Save Replay to YouTube'
      sleep 2; o 'Save Replay to YouTube'; waitfor copied https://youtu.be/test "$(cat "$E/direct-link.txt")"; ready_copy "$(last_uuid)"; osnap migrated
      curl -fsS -o /dev/null --data 'token=testing-refresh' http://127.0.0.1:9393/revoke
      o 'Save Replay to YouTube'; waitfor o --has 'Connect YouTube'; [[ -z $(keyring lookup grant "$grant") ]]; clean_tokens
    else
      waitfor o --has 'after restarting OBS'; osnap session-only; o OK --role button; waitfor o --has 'Save Replay to YouTube'
      sleep 2; o 'Save Replay to YouTube'; waitfor o --has 'Connect YouTube'; o 'Connect YouTube'; connect 'Reconnect YouTube' 1
      if o --has 'after restarting OBS'; then echo 'Repeated secure-storage notice' >&2; exit 1; fi
      old_link=$(clip || :); o Save --role button; sleep 2; o 'Save Replay to YouTube'; waitfor copied https://youtu.be/test "$old_link"; ready_copy "$(last_uuid)"; clean_tokens
    fi
    "$S/lab" quit "$id"
  done
  "$S/lab" obs "$id"; waitfor o --has 'Connect YouTube'; clean_tokens; rm "$R/no-keyring" ;;
*) echo "Unknown chapter: $phase" >&2; exit 2 ;;
esac
echo "PASS $phase; inspect $E"
