#!/usr/bin/python3
"""Find Qt controls by their accessible name, then click with real X input."""
import argparse
import os
import subprocess
import pyatspi as a

p = argparse.ArgumentParser(description=__doc__)
p.add_argument('name', nargs='?', help='exact accessible name; omit to list visible controls')
p.add_argument('--role', help='e.g. push button or text')
p.add_argument('--last', action='store_true', help='choose the last matching visible widget')
p.add_argument('--has', help='check for visible text without activating a control')
p.add_argument('--bounds', action='store_true', help='assert the entire named widget is on-screen; do not click')
p.add_argument('--indicator', action='store_true', help='toggle the checkbox and verify its indicator pixels change')
p.add_argument('--scroll-form', action='store_true', help='wheel the settings form down and back; assert the scrollbar moved')
p.add_argument('--scroll-end', action='store_true', help='wheel to the bottom and verify the last checkbox is above Save')
args = p.parse_args()
assert os.environ.get('DISPLAY') == ':97', 'Use only the private lab display'
matches = []

def walk(obj):
    if obj is None:
        return
    role, name = obj.getRoleName(), obj.name
    if (args.scroll_form or args.scroll_end) and role == 'scroll bar' and obj.getState().contains(a.STATE_SHOWING):
        if any(x.getRoleName() == 'dialog' for x in ancestors(obj)) and obj.queryValue().maximumValue > 0:
            matches.append(obj)
    elif args.has and obj.getState().contains(a.STATE_SHOWING) and args.has in (name or ''):
        matches.append(name)
    elif not args.has and 'Component' in obj.get_interfaces() and obj.getState().contains(a.STATE_SHOWING) and role not in ('application', 'label'):
        r = obj.queryComponent().getExtents(a.DESKTOP_COORDS)
        if r.width > 0 and r.height > 0:
            if args.name is None and not (args.scroll_form or args.scroll_end):
                if role not in ('menu item', 'filler', 'panel', 'scroll pane'):
                    print(role, repr(name), (r.x, r.y, r.width, r.height))
            elif name == args.name and (not args.role or role == args.role):
                matches.append((r.x, r.y, r.width, r.height))
    for child in obj:
        walk(child)

def ancestors(obj):
    while obj.parent:
        obj = obj.parent
        yield obj

for app in a.Registry.getDesktop(0):
    if app.name.lower() in ('obs', 'obs studio'):
        walk(app)
if args.has:
    raise SystemExit(0 if matches else 1)
if args.scroll_form or args.scroll_end:
    for bar in matches:
        r = bar.queryComponent().getExtents(a.DESKTOP_COORDS)
        if r.height <= r.width:
            continue
        def wheel(button):
            subprocess.run(['xdotool', 'mousemove', str(r.x+r.width//2), str(r.y+r.height//2), 'click', '--repeat', '8', button, 'sleep', '.2'], check=True)
        wheel('4'); top = bar.queryValue().currentValue
        wheel('5'); bottom = bar.queryValue().currentValue
        if args.scroll_end:
            for _ in range(10):
                if bottom == bar.queryValue().maximumValue: break
                wheel('5'); bottom = bar.queryValue().currentValue
            assert bottom == bar.queryValue().maximumValue and bottom > 0
            dialog = next(x for x in ancestors(bar) if x.getRoleName() == 'dialog')
            def bounds(name):
                obj = a.findDescendant(dialog, lambda x: x.name == name and x.getState().contains(a.STATE_SHOWING))
                return obj.queryComponent().getExtents(a.DESKTOP_COORDS)
            last = bounds('Start the Replay Buffer when OBS opens'); save = bounds('Save')
            assert r.y <= last.y < last.y + last.height <= r.y + r.height <= save.y
            print(f'Scroll {bottom:g}/{bar.queryValue().maximumValue:g}; last checkbox y={last.y}..{last.y+last.height}; Save y={save.y}')
            raise SystemExit(0)
        wheel('4')
        if bottom > top:
            print(f'Wheel moved form: {top:g} → {bottom:g}')
            raise SystemExit(0)
    raise SystemExit('Settings form did not scroll')
if args.name is not None:
    if not matches or (len(matches) != 1 and not args.last):
        raise SystemExit(f'{len(matches)} visible matches for {args.name!r}; list controls or use --role/--last')
    x, y, w, h = matches[-1]
    if args.bounds:
        sw, sh = map(int, subprocess.check_output(['xdotool', 'getdisplaygeometry']).split())
        assert 0 <= x < x+w <= sw and 0 <= y < y+h <= sh, (args.name, x,y,w,h,sw,sh)
        print(f'{args.name}: {x},{y} {w}×{h} inside {sw}×{sh}')
    else:
        def indicator():
            # Only the indicator, left of the text, with the mouse off the widget.
            subprocess.run(['xdotool', 'mousemove', '12', '12', 'sleep', '.2'], check=True)
            return subprocess.check_output(['import', '-window', 'root', '-crop', f'18x18+{x}+{y+h//2-9}', '-depth', '8', 'rgb:-'])
        if args.indicator:
            before = indicator()
        subprocess.run(['xdotool', 'mousemove', str(x+w//2), str(y+h//2), 'click', '1'], check=True)
        if args.indicator:
            after = indicator()
            changed = sum(before[i:i+3] != after[i:i+3] for i in range(0,len(before),3))
            assert len(before) == len(after) == 18*18*3 and changed > 8, f'Invisible checkbox: {changed} pixels changed'
            print(f'Checkbox indicator changed {changed} of 324 pixels')
